APP_NAME=SmartCareer FastAPI Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# LLM and embeddings keys. OpenRouter serves embeddings via /api/v1/embeddings.
# If you prefer direct OpenAI, set OPENAI_API_KEY and OPENAI_EMBEDDINGS_URL.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings

OPENAI_API_KEY=
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings


# Ollama Cloud - used strictly for chatbot
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_CHATBOT_MODEL=deepseek-v4-flash:cloud

REDIS_URL=redis://localhost:6379/0
REDIS_DISABLED=false

JWT_SECRET=
JWT_ALGORITHM=HS256

LOG_LEVEL=INFO

# Roadmap generation
# Set to false to disable DuckDuckGo fallback and rely only on RAG + Tavily
ENABLE_LEGACY_DDG_FALLBACK=true

