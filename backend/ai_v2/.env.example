# AI v2 Module Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Configuration (Optional for demo mode)
# ============================================================================

# OpenAI
OPENAI_API_KEY=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
LLM_MODEL=gpt-4

# Anthropic (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# LLaMA / Local Models (Alternative)
# LLAMA_MODEL_PATH=/path/to/model

# ============================================================================
# Embedding & RAG Configuration (Optional for demo mode)
# ============================================================================

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Backend (Pinecone, Weaviate, Milvus, FAISS, Chroma)
# VECTOR_STORE_TYPE=pinecone
# VECTOR_STORE_HOST=your-host
# VECTOR_STORE_API_KEY=your-api-key

# ============================================================================
# Database Configuration (Optional for production)
# ============================================================================

# Supabase
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable specific agents
ENABLE_PROFILE_AGENT=true
ENABLE_CV_AGENT=true
ENABLE_CAREER_AGENT=true
ENABLE_GAP_AGENT=true
ENABLE_ROADMAP_AGENT=true

# ============================================================================
# Notes
# ============================================================================
# - All environment variables are optional
# - Missing API keys will trigger mock implementations for testing
# - For production, ensure all sensitive keys are properly secured
