# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenRouter AI (for Career Quiz feature)
# Get API key from: https://openrouter.ai/keys
# Note: This is optional - quiz feature won't work without it
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-key-here

# Job Spy API (Python backend for job listings)
# Run Mobile/server/run.sh (or run.bat) to start the backend
EXPO_PUBLIC_JOB_API_URL=http://localhost:8000

# Main backend API (NestJS)
# Android emulator: use http://10.0.2.2:3000/api/v1
# iOS simulator: use http://localhost:3000/api/v1
# Physical device: use your PC LAN IP, e.g. http://192.168.1.10:3000/api/v1
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api/v1

# Instructions:
# 1. Copy this file to .env (do NOT commit .env to git)
# 2. Fill in your actual values
# 3. Restart Expo dev server: npm start
