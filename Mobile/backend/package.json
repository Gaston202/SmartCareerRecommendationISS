{
  "name": "@smartcareer/backend",
  "version": "1.0.0",
  "description": "Production AI Architecture for Smart Career Recommendation",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:deploy": "supabase db push",
    "migration:new": "supabase migration new",
    "worker:cv": "ts-node -r tsconfig-paths/register src/workers/cv.worker.ts",
    "worker:ai": "ts-node -r tsconfig-paths/register src/workers/ai.worker.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/websockets": "^10.3.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/swagger": "^8.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "bull": "^3.29.3",
    "bullmq": "^5.10.3",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.4.1",
    "axios": "^1.6.7",
    "zod": "^3.23.8",
    "handlebars": "^4.7.8",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "winston": "^3.11.0",
    "nest-winston": "^1.9.4",
    "pino-http": "^9.0.0",
    "uuid": "^9.0.1",
    "express-rate-limit": "^7.1.5",
    "passport-jwt": "^4.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.2.4",
    "eslint-config-prettier": "^9.1.0"
  },
  "peerDependencies": {
    "pg": ">=8.11.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
