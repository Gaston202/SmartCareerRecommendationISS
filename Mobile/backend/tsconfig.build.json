{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noEmitOnError": true,
  },
  "exclude": ["node_modules", "test", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["src/**/*"],
}
