# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter (AI)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Free web search enrichment for career market data (salary, growth, demand)
# Uses DuckDuckGo HTML search (no paid API key required)
ENABLE_MARKET_WEB_SEARCH=true
MARKET_WEB_SEARCH_TTL_SECONDS=86400

# Redis (optional cache). If Redis is not running locally, set REDIS_DISABLED=true to avoid connection errors.
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=false

# App
NODE_ENV=development
PORT=3000
API_VERSION=v1
JWT_SECRET=your_jwt_secret_for_internal_use

# CORS
CORS_ORIGIN=http://localhost:8081

# Monitoring
LOG_LEVEL=info
